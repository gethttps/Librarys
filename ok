    text  = "Ethum.lol {Game} {Time} {Date}",
    color = Color3.fromRGB(255, 255, 255),
}
Library._WatermarkHost = nil
Library._WatermarkRefresh = nil
Library._WatermarkConns = {}
Library._WatermarkPos = UDim2.fromOffset(10, 55)

local MONTHS = {"January","February","March","April","May","June","July",
                "August","September","October","November","December"}
local game_name_cache

local function get_game_name()
    if game_name_cache then return game_name_cache end
    game_name_cache = game.Name
    task.spawn(function()
        local ok, info = pcall(function()
            return MarketplaceService:GetProductInfo(game.PlaceId)
        end)
        if ok and info and info.Name then game_name_cache = info.Name end
    end)
    return game_name_cache
end

local function format_watermark(text)
    local t = os.date("*t")
    local h = t.hour % 12
    if h == 0 then h = 12 end
    local time_str = string.format("%d:%02d:%02d %s", h, t.min, t.sec, t.hour >= 12 and "PM" or "AM")
    local date_str = string.format("%s %d, %d", MONTHS[t.month], t.day, t.year)
    return (text:gsub("{(%a+)}", function(key)
        key = key:lower()
        if key == "game" then return get_game_name()
        elseif key == "time" then return time_str
        elseif key == "date" then return date_str end
    end))
end

local function destroy_watermark()
    if Library._WatermarkHost then Library._WatermarkHost:Destroy() end
    Library._WatermarkHost = nil
    Library._WatermarkRefresh = nil
    for _, c in ipairs(Library._WatermarkConns) do c:Disconnect() end
    Library._WatermarkConns = {}
end

function Library:_UpdateWatermark()
    if not self.WatermarkVisible then
        destroy_watermark()
        return
    end
    if self._WatermarkHost and self._WatermarkHost.Parent then
        if self._WatermarkRefresh then self._WatermarkRefresh() end
        return
    end

    local opts = self.WatermarkOptions
    local PAD, H = 8, 21

    local host = new_instance("Frame", {
        Name = "Watermark",
        BackgroundColor3 = Library.Theme.OuterBorder,
        BorderSizePixel = 0,
        Position = self._WatermarkPos,
        Size = UDim2.fromOffset(100, H),
        ZIndex = 400,
    }, screen_gui)
    Library:RegisterTheme(host, "BackgroundColor3", "OuterBorder")

    local f_inner = new_instance("Frame", {
        BackgroundColor3 = Library.Theme.InnerBorder,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(1, 1),
        Size = UDim2.new(1, -2, 1, -2),
        ZIndex = 400,
    }, host)
    Library:RegisterTheme(f_inner, "BackgroundColor3", "InnerBorder")

    local fill = new_instance("Frame", {
        BackgroundColor3 = Library.Theme.PanelFill,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(2, 2),
        Size = UDim2.new(1, -4, 1, -4),
        ZIndex = 400,
    }, host)
    vertical_gradient(fill, "HeaderTop", "HeaderBottom")

    local lbl = new_instance("TextLabel", {
        BackgroundTransparency = 1,
        Text = "",
        TextColor3 = opts.color,
        TextSize = FONT_SIZE,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextStrokeColor3 = Library.Theme.OuterBorder,
        TextStrokeTransparency = STROKE_T,
        TextTruncate = Enum.TextTruncate.None,
        Position = UDim2.fromOffset(PAD - 2, 0),
        Size = UDim2.new(1, -(PAD - 2), 1, 0),
        ZIndex = 401,
    }, fill)
    apply_font(lbl, false)
    Library:RegisterTheme(lbl, "TextStrokeColor3", "OuterBorder")

    local last_text
    local function refresh()
        local txt = format_watermark(opts.text or "")
        lbl.TextColor3 = opts.color
        if txt ~= last_text then
            last_text = txt
            lbl.Text = txt
            local w = TextService:GetTextSize(txt, FONT_SIZE, FONT, Vector2.new(10000, 100)).X
            host.Size = UDim2.fromOffset(math.ceil(w + PAD * 2), H)
        end
    end
    refresh()
    self._WatermarkRefresh = refresh

    local grab = new_instance("TextButton", {
        Name = "Drag",
        Text = "",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 402,
    }, host)

    local drag_input, start_pos, start_mouse
    grab.InputBegan:Connect(function(input)
        if is_click(input) and not pointer_busy(drag_input) then
            drag_input = input
            start_pos = host.Position
            start_mouse = Vector2.new(input.Position.X, input.Position.Y)
            close_all_popups()
        end
    end)
    table.insert(self._WatermarkConns, UserInputService.InputChanged:Connect(function(input)
        if not drag_input then return end
        local same = same_pointer(drag_input, input)
        if same then
            local d = Vector2.new(input.Position.X, input.Position.Y) - start_mouse
            local sz, scr = host.AbsoluteSize, screen_gui.AbsoluteSize
            local x = math.clamp(start_pos.X.Offset + d.X, 0, math.max(0, scr.X - sz.X))
            local y = math.clamp(start_pos.Y.Offset + d.Y, 0, math.max(0, scr.Y - sz.Y))
            host.Position = UDim2.fromOffset(x, y)
            Library._WatermarkPos = host.Position
        end
    end))
    table.insert(self._WatermarkConns, UserInputService.InputEnded:Connect(function(input)
        if input == drag_input then drag_input = nil end
    end))

    self._WatermarkHost = host

    task.spawn(function()
        while host.Parent do
            refresh()
            task.wait(0.5)
        end
    end)
end

