        BackgroundTransparency = 1,
        Text = "",
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.fromScale(1, 1),
        ZIndex = 2,
        AutoButtonColor = false,
    }, canvas)

    local window
    local drag_input, start_pos, start_mouse = nil, nil, nil

    -- while dragging from a section, pause column scrolling so only the window moves
    local function set_scroll(enabled)
        if not window then return end
        for _, t in ipairs(window.Tabs) do
            t.LeftCol.ScrollingEnabled = enabled
            t.RightCol.ScrollingEnabled = enabled
        end
    end

    local function begin_drag(input, from_section)
        if not is_click(input) then return end
        close_all_popups()
        if pointer_busy(drag_input) then return end
        drag_input = input
        start_pos = ui_pos(canvas)
        start_mouse = Vector2.new(input.Position.X, input.Position.Y)
        if from_section then set_scroll(false) end
    end

    drag_zone.InputBegan:Connect(function(input)
        begin_drag(input, false)
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not drag_input or not same_pointer(drag_input, input) then return end
        local d = Vector2.new(input.Position.X, input.Position.Y) - start_mouse
        canvas.Position = clamp_to_screen(start_pos + d, ui_size(canvas))
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input == drag_input then
            drag_input = nil
            set_scroll(true)
        end
    end)

    screen_gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        canvas.Position = clamp_to_screen(ui_pos(canvas), ui_size(canvas))
    end)

    window = setmetatable({
        Canvas   = canvas,
        TabHost  = tab_host,
        PageHost = page_host,
        Tabs     = {},
        ActiveTab= nil,
        _tab_w   = TAB_W,
        _tab_h   = TAB_H,
        _tab_sp  = TAB_SP,
        _oT1     = top_border1,
        _oT2     = top_border2,
        _iT1     = inner_top1,
        _iT2     = inner_top2,
        _tabs_total = tabs_total,
    }, {__index = Library._WindowMethods})

    window.BeginDrag = begin_drag

    function window:GetMinWidth()
        local panel_padding = 20
        local num = #self.Tabs
        if num == 0 then return MIN_SIZE.X end
        local total_tabs = num * TAB_W + math.max(0, num - 1) * TAB_SP
        return math.max(MIN_SIZE.X, total_tabs + 20)
    end

    add_resize_handles(canvas, function()
        update_tab_positions(window)
    end, window)

    return window
end

