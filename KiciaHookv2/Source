local function scanConfigNames()
	local names = {}
	local ok, files = pcall(function()
		return listfiles(CONFIG_DIR)
	end)
	if ok and type(files) == "table" then
		for _, path in ipairs(files) do
			local name = tostring(path):match("([^/\\]+)$")
			if name and string.lower(string.sub(name, -5)) == ".json" then
				names[#names + 1] = name
			end
		end
	end
	table.sort(names)
	table.clear(configNames)
	for _, name in ipairs(names) do
