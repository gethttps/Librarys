local function serverHop()
	local req = request or http_request or (syn and syn.request)
	if not req then
		dbg("Executor has no request function")
		return
	end
	task.spawn(function()
		local ok, result = pcall(function()
			local response = req({
				Url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(
					game.PlaceId
				),
			})
			return HttpService:JSONDecode(response.Body)
		end)
		if not ok or type(result) ~= "table" or not result.data then
			dbg("Server list request failed")
			return
		end
		local candidates = {}
		for _, server in ipairs(result.data) do
			if server.id ~= game.JobId and server.playing < server.maxPlayers then
				candidates[#candidates + 1] = server.id
			end
		end
		if #candidates == 0 then
			dbg("No other servers found")
			return
		end
		dbg("Hopping servers")
		pcall(function()
			TeleportService:TeleportToPlaceInstance(game.PlaceId, candidates[math.random(#candidates)], localPlayer)
		end)
	end)
end
