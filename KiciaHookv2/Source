local Library = {}
function Library.Toggle(text, enabled, options)
	local row = options or {}
	row.Kind = "Toggle"
	row.Text = text
	row.Enabled = enabled
	return row
end
function Library.Slider(text, value, minimum, maximum, decimals, onChange)
	return {
		Kind = "Slider",
		Text = text,
		Value = value,
		Min = minimum,
		Max = maximum,
		Decimals = decimals,
		OnChange = onChange,
	}
end
function Library.Caption(text)
	return { Kind = "Caption", Text = text }
end
function Library.Dropdown(options, default, multi, onChange)
	return { Kind = "Dropdown", Options = options, Default = default, Multi = multi, OnChange = onChange }
end
function Library.Button(text, action)
	return { Kind = "Button", Text = text, Action = action }
end
function Library.Field(placeholder)
	return { Kind = "Field", Placeholder = placeholder }
end
function Library.Color(text, color, onChange)
	return { Kind = "Color", Text = text, Color = color, OnChange = onChange }
end
function Library.ListBox(items, default, height)
	return { Kind = "ListBox", Items = items, Default = default, Height = height }
