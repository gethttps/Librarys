local function normalizeName(text)
	text = tostring(text or "")
	text = string.gsub(text, "[^%w _%-%.]", "")
	text = string.gsub(text, "^%s+", "")
	text = string.gsub(text, "%s+$", "")
	if text == "" then
		return nil
	end
	if string.lower(string.sub(text, -5)) ~= ".json" then
		text = text .. ".json"
	end
	return text
end
