local function applyAccent(newColor)
	local old, oldDark = ACCENT, ACCENT_DARK
	if newColor == old then
		return
	end
	local newDark = Color3.new(newColor.R * 0.45, newColor.G * 0.45, newColor.B * 0.45)
	ACCENT, ACCENT_DARK = newColor, newDark
	for _, object in ipairs(screen:GetDescendants()) do
		if object:IsA("GuiObject") then
			if object.BackgroundColor3 == old then
				object.BackgroundColor3 = newColor
			elseif object.BackgroundColor3 == oldDark then
				object.BackgroundColor3 = newDark
			end
			if object.BorderColor3 == old then
				object.BorderColor3 = newColor
			elseif object.BorderColor3 == oldDark then
